{
  "openapi": "3.0.3",
  "info": {
    "title": "Lightning SPP API",
    "version": "3.14.0",
    "description": "Local API for Lightning SPP licensing and health endpoints"
  },
  "servers": [
    {
      "url": "http://localhost:11400",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Get runtime pipeline metrics",
        "responses": {
          "200": {
            "description": "Runtime metrics snapshot",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "summary": "Get active SLO/SLA alert status",
        "responses": {
          "200": {
            "description": "Current alert state",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/stigma/schema": {
      "get": {
        "summary": "Get Stigma schema and version",
        "responses": {
          "200": {
            "description": "Stigma schema",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/license/status": {
      "get": {
        "summary": "Get current license status",
        "responses": {
          "200": {
            "description": "License status",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/license/activate": {
      "post": {
        "summary": "Activate a license key",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  }
                },
                "required": ["key"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activated"
          },
          "400": {
            "description": "Invalid input or activation failed"
          }
        }
      }
    },
    "/api/license/issue": {
      "post": {
        "summary": "Issue a new license key",
        "description": "Requires Authorization: Bearer <LSPP_ADMIN_TOKEN>",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "company": { "type": "string" },
                  "tier": { "type": "string", "example": "free" },
                  "devices": { "type": "integer", "format": "int32" },
                  "validityDays": { "type": "integer", "format": "int32" },
                  "useInternalQuantumSecurity": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "License issued"
          }
        }
      }
    },
    "/api/license/signing-status": {
      "get": {
        "summary": "Get signing key-ring status",
        "description": "Admin-only. Requires Authorization: Bearer <LSPP_ADMIN_TOKEN>",
        "responses": {
          "200": {
            "description": "Signing KID status",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}