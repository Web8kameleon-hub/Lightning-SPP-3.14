{
  "openapi": "3.0.3",
  "info": {
    "title": "Lightning SPP API",
    "version": "3.14.0",
    "description": "Local API for Lightning SPP licensing and health endpoints"
  },
  "servers": [
    {
      "url": "http://localhost:11400",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/license/status": {
      "get": {
        "summary": "Get current license status",
        "responses": {
          "200": {
            "description": "License status",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/license/activate": {
      "post": {
        "summary": "Activate a license key",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  }
                },
                "required": ["key"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activated"
          },
          "400": {
            "description": "Invalid input or activation failed"
          }
        }
      }
    },
    "/api/license/issue": {
      "post": {
        "summary": "Issue a new license key",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "company": { "type": "string" },
                  "tier": { "type": "string", "example": "free" },
                  "devices": { "type": "integer", "format": "int32" },
                  "validityDays": { "type": "integer", "format": "int32" },
                  "useInternalQuantumSecurity": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "License issued"
          }
        }
      }
    }
  }
}