# Lightning SPP 3.14 - Universal System
# Package configuration

[package]
name = "lightning-spp-universal"
version = "3.14.1"
description = "Modular scan, process, and print pipeline for .NET 10"
authors = ["wwwmmm Team", "Clisonix Global", "Web8 Kameleon Hub"]
license = "Component split: SDK/clients MIT; engine/runtime commercial (see LICENSE)"
keywords = ["scan", "print", "AI", "processing", "lightning", ".NET", "document-processing"]
repository = "https://github.com/Web8kameleon-hub/Lightning-SPP-3.14"
homepage = "https://scanprocessprint.com"

[features]
# Core Technologies
- TideWave scanning technology
- CLX processing engine
- CLI.I interactive processing
- XCL extended processing
- Resonance high-precision scanning
- NanoDecibel maximum quality scanning
- Clisonix Global AI processing
- Stigma adaptive pipeline control, lossless output
- Stigma Memory usage profiling
- Hybrid multi-engine processing

# Device-oriented profiles (selected per deployment, not separately certified)
- Medical, Mobile, IoT, Desktop, Web and Cloud device profiles
- Universal SDK entry points for each profile (MedicalAPI, MobileAPI, IoTAPI, CloudAPI)

[performance]
# Performance is hardware-, input- and configuration-dependent.
# No fixed latency or throughput numbers are published here.
# Run `dotnet run -- speed` on your own target hardware and report
# hardware spec, dataset, configuration and repetition count alongside
# any result. See https://scanprocessprint.com/benchmarks.

[deployment]
platforms = ["Windows", "Linux", "macOS"]
docker = true
aot = true

[distribution]
# The project defines a .NET NuGet package. Neither NuGet publication nor binary
# installer publication was found in the 11 October 2026 distribution audit.
# Java Longo is a separate private service; it is not a published Maven SDK.
nuget = "LightningSPP 3.14.1 (not published at audit time)"
