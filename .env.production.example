# Copy to .env.production on the host. Never commit the populated file.
LSPP_ADMIN_TOKEN=replace-with-a-random-32-byte-or-longer-token
LSPP_LICENSE_SIGNING_KEY=replace-with-a-random-signing-secret
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
WWWMMM_STIGMA_LEVEL=2
LSPP_TRUST_PROXY_HEADERS=true
LSPP_ALLOWED_ORIGINS=https://scanprocessprint.com,https://www.scanprocessprint.com
# Dynamic workspace remains disabled until its acceptance gates pass.
LSPP_WORKFLOW_ENABLED=false
LSPP_WORKFLOW_ALLOW_REMOTE_MODELS=false
LSPP_WORKFLOW_ALLOW_PRINT=false
LSPP_WORKFLOW_WORKERS=2
# Absolute operator-owned configuration paths; credentials stay in server env.
LSPP_MODEL_ROUTES_FILE=
LSPP_TOOL_ADAPTERS_FILE=
