[Unit]
Description=Lightning SPP API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lightning/publish
ExecStart=/usr/bin/dotnet /opt/lightning/publish/wwwmmm.dll serve 11400
Restart=always
RestartSec=3
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=XDG_CONFIG_HOME=/var/lib/lightning
Environment=LSPP_BIND_HOST=127.0.0.1
EnvironmentFile=/etc/lightning.env
StateDirectory=lightning

# Service hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/tmp
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
