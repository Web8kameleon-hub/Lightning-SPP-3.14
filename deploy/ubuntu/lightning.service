[Unit]
Description=Lightning SPP API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lightning/publish
ExecStart=/usr/bin/dotnet /opt/lightning/publish/wwwmmm.dll serve 11400
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data
Environment=LSPP_ENVIRONMENT=Production
Environment=LSPP_DATA_DIR=/var/lib/lightning
Environment=XDG_CONFIG_HOME=/var/lib/lightning
Environment=LSPP_TRUST_PROXY_HEADERS=true
EnvironmentFile=/etc/lightning/lightning.env
StateDirectory=lightning
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
