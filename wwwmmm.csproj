<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>wwwmmm</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>

    <!-- NuGet Package Metadata -->
    <PackageId>LightningSPP</PackageId>
    <Version>3.14.1</Version>
    <Authors>Ledjan Ahmati, ABA GmbH</Authors>
    <Company>ABA GmbH</Company>
    <Product>Lightning Scan-Process-Print System</Product>
    <Description>Modular scan-process-output toolkit using SkiaSharp, Microsoft.ML, ONNX Runtime, and lossless Brotli artifacts. Includes adaptive quality, balanced, and lightning execution profiles for desktop, web, edge, and cloud integration.</Description>
    <Copyright>Copyright © 2025-2026 ABA GmbH. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Web8kameleon-hub/Lightning-SPP-3.14</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Web8kameleon-hub/Lightning-SPP-3.14</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>scan;process;output;lightning;image-processing;ai;ml;iot;embedded;tidewave;clx;resonance;nanodecibel;clisonix;stigma</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
      Version 3.14.1
      - Self-service license activation: no admin token required for a valid, signed key
      - New edge-case integration tests for license activation/issuance auth boundaries
      - Public features/technology/pricing/benchmarks pages with Schema.org data
      - Corrected package.info to remove unverified certification and distribution claims
      - Compliance-sensitive deployments require independent validation and certification
    </PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".github\auto_assign.yml" />
    <None Include=".github\DISCUSSION_TEMPLATE\ideas.yml" />
    <None Include=".github\DISCUSSION_TEMPLATE\show-and-tell.yml" />
    <None Include=".github\ISSUE_TEMPLATE\bug_report.yml" />
    <None Include=".github\ISSUE_TEMPLATE\config.yml" />
    <None Include=".github\ISSUE_TEMPLATE\feature_request.yml" />
    <None Include=".github\ISSUE_TEMPLATE\question.yml" />
    <None Include=".github\labeler.yml" />
    <None Include=".github\pull_request_template.md" />
    <None Include=".github\workflows\auto-assign-reviewers.yml" />
    <None Include=".github\workflows\auto-label.yml" />
    <None Include=".github\workflows\community-welcome.yml" />
    <None Include=".github\workflows\stale.yml" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="SECURITY.md" Pack="true" PackagePath="\" />
    <None Include="COMPLIANCE.md" Pack="true" PackagePath="\" />
    <None Include="PRICING.md" Pack="true" PackagePath="\" />
    <Content Include="Web\wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\LightningSPP.Tests\**\*.cs" />
    <Compile Remove="VSExtension\**\*.cs" />
    <Compile Remove="Desktop\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\workflows\ci-cd.yml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />

    <!-- Real Image Processing -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />

    <!-- Real AI/ML -->
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
    <PackageReference Include="Stripe.net" Version="51.1.0" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />

  </ItemGroup>

</Project>
