index 0000000..b824c23
--- /dev/null
+++ b/services/excel/test_excel_cleanup.py
@@ -0,0 +1,104 @@
+"""Real workbook processing and upload cleanup; fixture data is test-only."""
+import io
+import tempfile
+import unittest
+from pathlib import Path
+
+import httpx
+from openpyxl import Workbook
+
+import main
+
+
+class ExcelCleanupTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.previous_uploads = main.UPLOADS_DIR
+        main.UPLOADS_DIR = Path(self.directory.name)
+        self.client = httpx.AsyncClient(transport=httpx.ASGITransport(app=main.app), base_url="http://test")
+
+    async def asyncTearDown(self):
+        await self.client.aclose()
+        main.UPLOADS_DIR = self.previous_uploads
+        self.directory.cleanup()
+
+    @staticmethod
+    def workbook():
+        wb = Workbook()
+        wb.active.append(["Name", "Count"])
+        wb.active.append(["fixture", 2])
+        buffer = io.BytesIO()
+        wb.save(buffer)
+        wb.close()
+        return buffer.getvalue()
+
+    async def test_validate_closes_workbook_before_cleanup(self):
+        response = await self.client.post("/api/excel/validate", files={"file": ("fixture.xlsx", self.workbook())})
+        self.assertEqual(response.status_code, 200)
+        self.assertTrue(response.json()["valid"])
+        self.assertEqual(list(main.UPLOADS_DIR.iterdir()), [])
+
+    async def test_parse_closes_workbook_before_cleanup(self):
+        response = await self.client.post("/api/excel/parse", files={"file": ("fixture.xlsx", self.workbook())})
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["data"], [{"Name": "fixture", "Count": 2}])
+        self.assertEqual(list(main.UPLOADS_DIR.iterdir()), [])
+
+    async def test_invalid_workbook_is_not_valid_and_is_removed(self):
+        response = await self.client.post("/api/excel/validate", files={"file": ("invalid.xlsx", b"not a workbook")})
+        self.assertEqual(response.status_code, 200)
+        self.assertFalse(response.json()["valid"])
+        self.assertEqual(list(main.UPLOADS_DIR.iterdir()), [])
+
+    async def test_invalid_parse_fails_and_is_removed(self):
+        response = await self.client.post("/api/excel/parse", files={"file": ("invalid.xlsx", b"not a workbook")})
+        self.assertEqual(response.status_code, 500)
+        self.assertEqual(list(main.UPLOADS_DIR.iterdir()), [])
+
+    async def test_zero_and_false_values_are_preserved(self):
+        wb = Workbook()
+        wb.active.append([0, False, "Count"])
+        wb.active.append([0, False, 0])
+        buffer = io.BytesIO()
+        wb.save(buffer)
+        wb.close()
+        response = await self.client.post("/api/excel/parse", files={"file": ("zero.xlsx", buffer.getvalue())})
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["headers"], ["0", "False", "Count"])
+        self.assertEqual(response.json()["rows"], 1)
+        self.assertEqual(response.json()["data"], [{"0": 0, "False": False, "Count": 0}])
+
+    async def test_duplicate_headers_do_not_overwrite_cells(self):
+        wb = Workbook()
+        wb.active.append(["Name", "Name", "Name_2"])
+        wb.active.append(["first", "second", "third"])
+        buffer = io.BytesIO()
+        wb.save(buffer)
+        wb.close()
+        response = await self.client.post("/api/excel/parse", files={"file": ("duplicates.xlsx", buffer.getvalue())})
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["headers"], ["Name", "Name_3", "Name_2"])
+        self.assertEqual(response.json()["data"], [{"Name": "first", "Name_3": "second", "Name_2": "third"}])
+
+    async def test_preview_limit_preserves_total_row_count(self):
+        wb = Workbook()
+        wb.active.append(["Count"])
+        for index in range(120):
+            wb.active.append([index])
+        buffer = io.BytesIO()
+        wb.save(buffer)
+        wb.close()
+        response = await self.client.post("/api/excel/parse", files={"file": ("large.xlsx", buffer.getvalue())})
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["rows"], 120)
+        self.assertEqual(len(response.json()["data"]), 100)
+        self.assertEqual(response.json()["data"][0], {"Count": 0})
+
+    async def test_requested_missing_sheet_does_not_fall_back(self):
+        response = await self.client.post("/api/excel/parse?sheet=missing", files={"file": ("fixture.xlsx", self.workbook())})
+        self.assertEqual(response.status_code, 404)
+        self.assertEqual(list(main.UPLOADS_DIR.iterdir()), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
