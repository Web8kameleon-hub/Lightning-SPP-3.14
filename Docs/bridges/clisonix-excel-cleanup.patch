+    reserved = set(names)
+    used = set()
+    headers = []
+    for name in names:
+        candidate = name
+        suffix = 2
+        while candidate in used:
+            candidate = f"{name}_{suffix}"
+            suffix += 1
+            while candidate in reserved:
+                candidate = f"{name}_{suffix}"
+                suffix += 1
+        used.add(candidate)
+        headers.append(candidate)
+    return headers
 
