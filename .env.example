# Generate two different values with: openssl rand -hex 32
LSPP_ADMIN_TOKEN=
LSPP_LICENSE_SIGNING_KEY=
HOST_PORT=13080

# OCR is opt-in and never runs unless this is exactly "true".
# It is only used when a PDF has no text layer, and the document flow then reports
# textSource=ocr for that file. Requires Tesseract.
# LSPP_OCR_ENABLED=true
# SPP_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# SPP_OCR_LANGUAGES=eng
# Poppler, used for the PDF text layer (without OCR):
# SPP_PDFTOTEXT_PATH=C:\Program Files\poppler\Library\bin\pdftotext.exe
# Build licenses belong in the private .env.build file.

# ---- AI assistant / model routes -------------------------------------------------
# The AI assistant needs a real model. With nothing configured the server looks for a
# local Ollama runtime on loopback only (no credential, no remote host) and uses the
# first completion-capable model it actually finds. Point it at a specific tag here.
# LSPP_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# LSPP_MODEL_PREFER=qwen3:8b
# LSPP_MODEL_AUTODISCOVER=off        # set to 'off' to forbid loopback discovery entirely
# LSPP_MODEL_ROUTES_FILE=C:\absolute\path\model-routes.json   # operator file wins over discovery
#
# The public assistant (/api/assistant) answers from the local model when one is found and
# The public assistant requires explicit operator enablement.
# LSPP_GUEST_ASSISTANT_ENABLED=true
